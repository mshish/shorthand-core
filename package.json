{
  "name": "shorthand-core",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "author": "Michael Sciscenti",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./markdown": "./src/markdown.ts",
    "./testing": "./src/testing/sink-conformance.ts"
  },
  "bin": {
    "shorthand-notes": "./dist/shorthand-notes.mjs"
  },
  "scripts": {
    "build": "esbuild bin/shorthand-notes.ts --bundle --platform=node --format=esm --target=node20 --external:@anthropic-ai/claude-agent-sdk --outfile=dist/shorthand-notes.mjs",
    "capture": "bun bin/shorthand-notes.ts capture",
    "test": "bun test",
    "test:e2e": "node test/e2e-smoke.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.190",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "22.14.0",
    "esbuild": "0.25.9",
    "typescript": "5.9.3"
  }
}

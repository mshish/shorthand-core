{
  "name": "shorthand-core",
  "version": "0.16.0",
  "private": true,
  "license": "MIT",
  "author": "Michael Sciscenti",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.ts",
    "./markdown": "./src/markdown.ts",
    "./google": "./src/google.ts",
    "./testing": "./src/testing/index.ts"
  },
  "bin": {
    "shorthand-notes": "./dist/shorthand-notes.mjs"
  },
  "scripts": {
    "build": "esbuild bin/shorthand-notes.ts --bundle --platform=node --format=esm --target=node22 --external:@anthropic-ai/claude-agent-sdk --external:@openai/codex-sdk --external:@googleapis/docs --external:google-auth-library --external:ai --external:@ai-sdk/openai --external:@ai-sdk/anthropic --external:@ai-sdk/openai-compatible --outfile=dist/shorthand-notes.mjs",
    "capture": "bun bin/shorthand-notes.ts capture",
    "test": "bun test",
    "test:e2e": "node test/e2e-smoke.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.40",
    "@ai-sdk/openai": "^4.0.45",
    "@ai-sdk/openai-compatible": "^3.0.34",
    "@anthropic-ai/claude-agent-sdk": "^0.3.233",
    "@googleapis/docs": "^10.0.0",
    "@openai/codex-sdk": "^0.149.1",
    "ai": "^7.0.74",
    "google-auth-library": "10.5.0",
    "marked": "^18.0.10",
    "xstate": "5.32.5",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "22.14.0",
    "esbuild": "0.25.9",
    "typescript": "5.9.3"
  }
}

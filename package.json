{
  "name": "obsidian-handy-notes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./markdown": "./src/markdown.ts",
    "./testing": "./src/testing/sink-conformance.ts",
    "./plugin-ui": "./src/plugin/index.ts"
  },
  "bin": {
    "handy-notes": "./dist/handy-notes.mjs"
  },
  "scripts": {
    "build": "esbuild bin/handy-notes.ts --bundle --platform=node --format=esm --target=node20 --external:@anthropic-ai/claude-agent-sdk --outfile=dist/handy-notes.mjs",
    "build:plugin": "bun plugin/esbuild.config.mjs",
    "capture": "bun bin/handy-notes.ts capture",
    "test": "bun test",
    "test:e2e": "node test/e2e-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "install:local": "node scripts/install-local.mjs",
    "dev:plugin": "bun scripts/dev-plugin.mjs",
    "version:bump": "node scripts/version-bump.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.190",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "22.14.0",
    "esbuild": "0.25.9",
    "obsidian": "1.5.7",
    "typescript": "5.9.3"
  }
}

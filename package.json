{
  "name": "shorthand-core",
  "version": "0.23.0",
  "private": true,
  "license": "MIT",
  "author": "Michael Sciscenti",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.ts",
    "./markdown": "./src/markdown.ts",
    "./google": "./src/google.ts",
    "./testing": "./src/testing/index.ts"
  },
  "bin": {
    "shorthand-notes": "./dist/shorthand-notes.mjs"
  },
  "scripts": {
    "build": "esbuild bin/shorthand-notes.ts --bundle --platform=node --format=esm --target=node22 --external:@agentclientprotocol/sdk --external:@anthropic-ai/claude-agent-sdk --external:@openai/codex-sdk --external:@googleapis/docs --external:google-auth-library --external:ai --external:@ai-sdk/openai --external:@ai-sdk/anthropic --external:@ai-sdk/openai-compatible --external:ai-sdk-ollama --outfile=dist/shorthand-notes.mjs",
    "capture": "bun bin/shorthand-notes.ts capture",
    "test": "bun test",
    "test:e2e": "node test/e2e-smoke.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.7.0",
    "@ai-sdk/anthropic": "^4.0.71",
    "@ai-sdk/openai": "^4.0.84",
    "@ai-sdk/openai-compatible": "^3.0.63",
    "@anthropic-ai/claude-agent-sdk": "^0.3.289",
    "@googleapis/docs": "^14.1.0",
    "@openai/codex-sdk": "^0.149.1",
    "ai": "^7.0.128",
    "ai-sdk-ollama": "^4.4.0",
    "google-auth-library": "11.1.0",
    "marked": "^18.1.0",
    "xstate": "5.33.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "typescript": "6.0.3"
  }
}

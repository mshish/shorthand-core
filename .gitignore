node_modules/

# Local secrets (e.g. GOOGLE_OAUTH_CLIENT_ID/SECRET) — never committed.
.env
.env.*

# Build artifacts — rebuild with `bun run build`.
dist/

# Scratch dirs from local test runs.
.block-writer-*test-*/

# Local git worktrees (SDD scratch)
.worktrees/

# Agent scratch: session state, worktrees, ledgers, briefs, review packages.
# These carry local absolute paths and pasted tool output. The repo is public,
# so a stray `git add -A` would publish them.
.superpowers/
.claude/
.serena/
